{
  "name": "valentinos-magic-beans",
  "version": "1.0.0",
  "description": "Playwright E2E & API test suite for Valentino's Magic Beans coffee shop",
  "main": "index.js",
  "scripts": {
    "test": "npx playwright test",
    "test:e2e": "npx playwright test --project=chromium",
    "test:api": "npx playwright test --project=api-tests",
    "allure:generate": "npx allure generate allure-results --clean --single-file -o allure-report",
    "allure:open": "npx allure open allure-report",
    "allure:serve": "npx allure serve allure-results"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.10.2"
  }
}
